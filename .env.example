# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# TELEGRAM_BOT_TOKEN: Bot token from @BotFather for live Telegram bot operation.
TELEGRAM_BOT_TOKEN=

# ADMIN_PASSCODE: Optional admin passcode to lock the web dashboard (if empty, first-run setup is shown).
ADMIN_PASSCODE=
